# ================================================================
# Stock Crew AI Environment Configuration
# ================================================================

# Gemini API Key Pool Configuration
# You can provide a single key OR multiple keys for automatic quota rotation.
# When any key encounters a daily rate limit (HTTP 429 RESOURCE_EXHAUSTED),
# the system rotates to the next available key in the pool.

# Option 1 (Recommended): Comma-separated keys in GEMINI_API_KEY
GEMINI_API_KEY="AIzaSyYourFirstKey...,AIzaSyYourSecondKey...,AIzaSyYourThirdKey..."

# Option 2: Numbered keys
# GEMINI_API_KEY_1="AIzaSyYourFirstKey..."
# GEMINI_API_KEY_2="AIzaSyYourSecondKey..."
# GEMINI_API_KEY_3="AIzaSyYourThirdKey..."

# Port for local web server (defaults to 3000)
PORT=3000
